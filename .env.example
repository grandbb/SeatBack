# ─── Network ─────────────────────────────────────────────────────────────────
# "testnet" uses Arc Testnet (chain 5042002, default for development)
# "mainnet" uses Arc Mainnet  (chain 5042, real USDC)
VITE_NETWORK=testnet

# ─── Contract addresses ───────────────────────────────────────────────────────
# Testnet — already deployed; override only if you redeploy
# VITE_TESTNET_SEATBACK_ADDRESS=0x807f6bef741e807472e9f07d6d0fbaf061dba6ba

# Mainnet — must be set before a mainnet build is usable
# Deploy the contract yourself with: forge script contracts/script/DeploySeatBack.s.sol
# then paste the resulting address here.
# VITE_MAINNET_SEATBACK_ADDRESS=0x...

# ─── RPC proxy (Arc Studio sandbox only — not needed for deployments) ─────────
# RPC_PROXY_BASE_URL=
# RPC_PROXY_TOKEN=
# RPC_PROXY_CHAINS=
